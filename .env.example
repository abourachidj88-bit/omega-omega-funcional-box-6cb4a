# Copiá este archivo como .env (que Git ignora) y completá los valores reales.
# En Render estas variables se cargan en: servicio -> Environment. NUNCA las escribas en el código.

# --- Aplicación web (Render) ---
OMEGA_NODO=nube
# Clave compartida entre la PC y la nube. Render la genera sola (render.yaml); acá solo se copia.
SYNC_CLAVE=

# --- PC del gimnasio ---
# Dirección de la nube y la misma clave (el instalador las guarda en C:\OMEGA\nube.txt)
NUBE_URL=
NUBE_CLAVE=

# --- Opcionales ---
# OMEGA_SECRET=          # firma de sesiones (si no se define, se genera y guarda en la base)
# DATA_DIR=              # carpeta de la base de datos
# BACKUP_DIR=            # carpeta de las copias
# ANTHROPIC_API_KEY=     # solo si algún día se suma IA con la API de Claude
